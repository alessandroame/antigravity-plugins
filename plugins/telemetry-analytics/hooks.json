{
  "telemetry-collector": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/eta-injector.mjs",
        "timeout": 10
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/collector.mjs",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/collector.mjs --finalize",
        "timeout": 15
      }
    ]
  }
}
